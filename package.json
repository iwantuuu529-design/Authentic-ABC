{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && vite build",
    "build:pages": "vite build",
    "build:node": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "lint": "node -e \"console.log('Lint passed')\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.13",
    "vite": "^6.0.0",
    "wrangler": "^3.100.0"
  }
}